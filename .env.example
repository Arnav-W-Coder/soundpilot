# Copy to .env (git-ignored) and fill in. The backend (uvicorn mixassist.api:app, python -m mixassist, evals)
# loads .env at startup; variables already set in the shell win. Server-side only: never copy keys into web/.

# Provider: vertex (default) | aistudio | ollama
SOUNDPILOT_LLM=
# Model ID; empty = provider default (vertex gemma-4-26b-a4b-it-maas, aistudio gemma-4-26b-a4b-it, ollama gemma4:31b-cloud)
SOUNDPILOT_MODEL=

# Vertex AI (uses ADC: gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Ollama (default http://127.0.0.1:11434)
OLLAMA_HOST=

# Web access for the agent (web_search / web_fetch): 1 (default) or 0
SOUNDPILOT_WEB=
# Search backend: auto (default: first key below, else keyless ddgs) | ddgs | ollama | brave | tavily
SOUNDPILOT_WEB_BACKEND=
# Optional search keys (more reliable than keyless search): https://ollama.com/settings/keys,
# https://brave.com/search/api/, https://tavily.com
OLLAMA_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
